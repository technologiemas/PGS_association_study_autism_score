TITLE: Configural model self;
DATA: 
    file = ../../../data/processed/measurement_invariance/item_data_self.dat;
    FORMAT = FREE;

VARIABLE:
  NAMES = item1-item9 sex family;
  CATEGORICAL = item1-item9;
  GROUPING = sex (1 = male 2 = female);
  CLUSTER = family;
  MISSING = *;

ANALYSIS:
  ESTIMATOR = WLSMV;
  TYPE = COMPLEX;
  PARAMETERIZATION = THETA;    ! needed to estimate residual
!  STARTS = 50;
! variances for categorical indicators

MODEL:
  F BY item1-item9* (L1-L9); ! freely estimate
  ! identification: factor mean fixed to zero in male
  [F@0];

  ! factor variance fixed to 1 in male
  F@1;

  ! thresholds for male: estimated freely but we label 
  !them so they can be referenced in female
  [item1$1-item9$1] (ta1-ta9);
  [item1$2-item9$2] (tb1-tb9);

  ! residual variances: fixed to 1 in male 
  item1-item9@1;  

! ---------- GROUP 2: FEMALE ----------
MODEL female:
! Factor loadings freely estimated
  F BY item1-item9*;

  ! factor mean estimated freely in female
  [F];     

  ! factor variance fixed to 1 in female as required
  F@1;

  ! constrain all first thresholds equal with males
  [item1$1-item9$1] (ta1-ta9);
  
  ! constrain the second threshold of the reference item (8)
  [item4$2] (tb4);

  ! free all other second thresholds
  [item1$2-item3$2 item5$2-item9$2];

  ! Residual variances: estimated freely in female 
  item1-item9*;

SAVEDATA:
DIFFTEST = configural_model_self.dat;

OUTPUT:
  MODINDICES(ALL, 20)
  STDYX;
